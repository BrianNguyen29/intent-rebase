# ============================================================
# Staging Environment — Environment Variables Template
# ============================================================
#
# PURPOSE: Safe placeholder values for staging environment.
# DO NOT copy these directly to .env — replace with actual values.
# DO NOT commit real credentials to version control.
#
# This file documents the required environment variables for
# staging deployment. All values here are placeholders.
#
# REQUIRED: Copy to .env and replace with staging-appropriate values
# before running docker compose -f infrastructure/staging/docker-compose.yml up
# ============================================================

# ============================================================
# STAGING CREDENTIALS — REPLACE BEFORE USE
# ============================================================

# Postgres (staging)
# Replace with a strong random password for staging use
STAGING_POSTGRES_PASSWORD=CHANGE_ME_staging_secure_password

# MinIO (staging)
# Replace with staging-appropriate credentials
STAGING_MINIO_ROOT_USER=staging_minioadmin
STAGING_MINIO_ROOT_PASSWORD=CHANGE_ME_staging_minio_password

# Grafana (staging observability)
STAGING_GRAFANA_USER=staging_admin
STAGING_GRAFANA_PASSWORD=CHANGE_ME_staging_grafana_password

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgres://intent_rebase_staging:${STAGING_POSTGRES_PASSWORD}@localhost:5433/intent_rebase_staging

# ============================================================
# Runtime Adapter (bounded selection — Phase 2b)
# ============================================================
# Controls which runtime adapter is used for rebase operations.
# Default (not set or =mock): MockAdapter — dev/testing only, no real Temporal connection.
# When =temporal: TemporalAdapter — requires temporal feature compiled in AND TEMPORAL_ADDRESS/TEMPORAL_NAMESPACE set.
# Production Temporal readiness is NOT claimed. Trace propagation (W3C traceparent) is NOT supported.
# INTENT_API_RUNTIME_ADAPTER=mock
# TEMPORAL_ADDRESS=http://localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=intent-rebase
# TEMPORAL_IDENTITY=intent-rebase-runtime-adapter

# ============================================================
# NATS (staging — port offset from local dev)
# ============================================================
NATS_URL=nats://localhost:4223

# ============================================================
# S3 / MinIO (staging)
# ============================================================
AWS_ACCESS_KEY_ID=${STAGING_MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${STAGING_MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=intent-rebase-staging-artifacts

# ============================================================
# Forensic Bundle Storage (staging — bounded S3 wiring)
# ============================================================
# Set FORENSIC_BUNDLE_STORAGE=s3 to enable S3/minIO storage for forensic bundles.
# When FORENSIC_BUNDLE_STORAGE=s3, also set:
#   S3_ENDPOINT (already configured above)
#   S3_ACCESS_KEY (set explicitly; code does not derive this from AWS_ACCESS_KEY_ID)
#   S3_SECRET_KEY (set explicitly; code does not derive this from AWS_SECRET_ACCESS_KEY)
#   FORENSIC_BUNDLE_BUCKET (e.g., intent-rebase-staging-bundles)
# Object Lock, retention enforcement, chain-hash remain Phase 4+ deferred scope.
# FORENSIC_BUNDLE_STORAGE=s3
# S3_ACCESS_KEY=${STAGING_MINIO_ROOT_USER}
# S3_SECRET_KEY=${STAGING_MINIO_ROOT_PASSWORD}
# FORENSIC_BUNDLE_BUCKET=intent-rebase-staging-bundles

# ============================================================
# OBSERVABILITY
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=intent-rebase-staging

# ============================================================
# APPLICATION
# ============================================================
RUST_LOG=info
RUST_BACKTRACE=1

# ============================================================
# STAGING-SPECIFIC TOGGLES
# ============================================================

# Enable staging mode (different from production)
STAGING_MODE=true

# Rate limiting (staging may have different limits)
# RATE_LIMIT_REQUESTS_PER_SECOND=100
# RATE_LIMIT_BURST=200
