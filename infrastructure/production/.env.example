# GCP Project Configuration
# TEMPLATE ONLY — replace all CHANGE_ME_* values before use; do not commit this file with real values.

# GCP project used for bootstrap and applied scaffold.
# Terraform has been applied to this project; this file remains a template
# for operators. Do not commit with real values.
GCP_PROJECT_ID=ferrum-497801
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
ENVIRONMENT=production-template

# Application Domain / Ingress
APP_DOMAIN=CHANGE_ME_APP_DOMAIN

# Alertmanager Receivers (placeholders only)
SLACK_WEBHOOK_URL=CHANGE_ME_SLACK_WEBHOOK_URL
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=CHANGE_ME_SMTP_FROM
SMTP_TO=CHANGE_ME_SMTP_TO

# JWT Authentication (Phase 2b bounded slice)
# Set JWT_SECRET to a strong secret (≥32 bytes, no 'dev', 'secret', 'password', etc.)
# JWT_SECRET_PREVIOUS (optional): previous secret for verification-only fallback during rotation grace window.
# When set, tokens signed with the old secret are still accepted until the grace window closes.
JWT_SECRET=CHANGE_ME_production_jwt_secret_min_32_chars
# JWT_SECRET_PREVIOUS=CHANGE_ME_production_jwt_previous_secret_min_32_chars
INTENT_API_REQUIRE_JWT=true
