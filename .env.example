# Database
DATABASE_URL=postgres://intent_rebase:intent_rebase_dev@localhost:5432/intent_rebase

# JWT Authentication (Phase 2b bounded slice)
# Set JWT_SECRET to a strong secret (≥32 bytes, no 'dev', 'secret', 'password', etc.)
# INTENT_API_REQUIRE_JWT=true enables strict production guard (fails startup if secret is weak/missing)
JWT_SECRET=your-strong-secret-here-min-32-chars
INTENT_API_REQUIRE_JWT=false

# Runtime Adapter (bounded selection — Phase 2b)
# Controls which runtime adapter is used for rebase operations.
# Default (not set or =mock): MockAdapter — dev/testing only, no real Temporal connection.
# When =temporal: TemporalAdapter — requires temporal feature compiled in AND TEMPORAL_ADDRESS/TEMPORAL_NAMESPACE set.
# Production Temporal readiness is NOT claimed. Trace propagation (W3C traceparent) is NOT supported.
# INTENT_API_RUNTIME_ADAPTER=mock
# TEMPORAL_ADDRESS=http://localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=intent-rebase
# TEMPORAL_IDENTITY=intent-rebase-runtime-adapter

# NATS
NATS_URL=nats://localhost:4222

# S3 / MinIO (local dev)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intent-rebase-artifacts

# Forensic Bundle Storage (bounded S3 wiring)
# Set FORENSIC_BUNDLE_STORAGE=s3 to enable S3/minIO storage for forensic bundles.
# When not set or set to any other value, uses in-memory storage (dev/testing only).
# When FORENSIC_BUNDLE_STORAGE=s3, also set:
#   S3_ENDPOINT (e.g., http://localhost:9000 for local MinIO)
#   S3_ACCESS_KEY (e.g., minioadmin for local MinIO)
#   S3_SECRET_KEY (e.g., minioadmin for local MinIO)
#   FORENSIC_BUNDLE_BUCKET (e.g., intent-rebase-artifacts)
# Object Lock, retention enforcement, chain-hash remain Phase 4+ deferred scope.
# FORENSIC_BUNDLE_STORAGE=s3
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# FORENSIC_BUNDLE_BUCKET=intent-rebase-artifacts

# Observability (Phase 1+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=intent-rebase

# App
RUST_LOG=info
RUST_BACKTRACE=1
