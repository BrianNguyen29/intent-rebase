# Database
DATABASE_URL=postgres://intent_rebase:intent_rebase_dev@localhost:5432/intent_rebase

# JWT Authentication (Phase 2b bounded slice)
# Set JWT_SECRET to a strong secret (≥32 bytes, no 'dev', 'secret', 'password', etc.)
# INTENT_API_REQUIRE_JWT=true enables strict production guard (fails startup if secret is weak/missing)
JWT_SECRET=your-strong-secret-here-min-32-chars
INTENT_API_REQUIRE_JWT=false

# NATS
NATS_URL=nats://localhost:4222

# S3 / MinIO (local dev)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=intent-rebase-artifacts

# Observability (Phase 1+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=intent-rebase

# App
RUST_LOG=info
RUST_BACKTRACE=1
